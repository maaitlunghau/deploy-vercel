{
    "builds": [
        {
        "src": "admin-dashboard/package.json",
        "use": "@vercel/static-build",
        "config": { "distDir": "admin-dashboard/dist" }
        }
    ],
    "routes": [
        { "src": "^/admin-dashboard/(.*)", "dest": "/admin-dashboard/dist/$1" },
        { "src": "^/admin-dashboard/?$", "dest": "/admin-dashboard/dist/index.html" }
    ]
}
