{
  "builds": [
    {
      "src": "admin-dashboard/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "admin-dashboard/dist" }
    }
  ],
  "rewrites": [
    { "source": "/admin-dashboard/(.*)", "destination": "/admin-dashboard/dist/$1" }
  ],
  "redirects": [
    { "source": "/", "destination": "/admin-dashboard" }
  ]
}